# Copy this file to .env and fill in real values before running in production.

# Signs session cookies and CSRF tokens. MUST be a strong random value in
# production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-in-prod

DATABASE_URL=sqlite:///./data/crm.db

# Calendar timezone for "due today" on the follow-up gate and deal pills.
# Containers default to UTC; set any IANA zone, e.g. America/New_York.
# Australia: Australia/Sydney, Melbourne, Canberra, Hobart (AEST/AEDT),
# Brisbane (AEST, no DST), Adelaide (ACST/ACDT), Darwin (ACST), Perth (AWST).
TZ=UTC

# Public HTTPS URL of this deployment.
BASE_URL=http://localhost:8000

# Set to "true" to require Secure cookies (production/HTTPS deployments).
SECURE_COOKIES=false

# --- Lead ingestion (POST /api/v1/leads) ---
# Shared secret an automation tool sends as X-API-Key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Unset means every request to /api/v1/leads is rejected (fails closed).
# Header only — never put the key in the query string.
CRM_API_KEY=

# --- Pipeline stages API (/api/v1/stages, script/agent config of the workflow) ---
# Deliberately a SEPARATE secret from CRM_API_KEY. This key can create, edit,
# reorder and delete pipeline stages and their roles — a much bigger blast
# radius than "post a lead". Generate the same way.
# Unset means every request to /api/v1/stages is rejected (fails closed).
CRM_STAGES_API_KEY=

# --- MCP (POST /mcp — for AI agents) ---
# Separate from both keys above. This key can read and write partners, deals
# and activities. It cannot delete records or reshape the pipeline.
# Unset means every request to /mcp is rejected (fails closed) and OAuth
# authorize is disabled. Send it as Authorization: Bearer <key> or X-API-Key
# (header only, never a query string). Hosted connectors that only speak
# OAuth 2.1 (PKCE) use /oauth/authorize; paste this key there, or log in.
CRM_MCP_API_KEY=

# --- Nurture hand-off (optional outbound webhook) ---
# When a deal enters a stage flagged "triggers nurture", the CRM POSTs JSON
# {email, name, list_slug, partner_id, deal_id} here. Unset = skipped, and a
# system note is logged on the timeline. Optional Bearer token below.
NURTURE_WEBHOOK_URL=
NURTURE_WEBHOOK_TOKEN=

# --- Delegated tasks (optional outbound webhook) ---
# Owner slug that receives delegated tasks by default (MCP create_delegated_task).
# When a task is owned by this slug and its status is "delegated", the CRM POSTs
# JSON {task_id, deal_id, partner_id, partner_name, title, brief, due_date,
# owner, status, crm_links} to TASK_WEBHOOK_URL once. Unset = skip the webhook;
# the agent can still poll list_delegated_tasks over MCP.
DELEGATE_DEFAULT_OWNER=agent
TASK_WEBHOOK_URL=
TASK_WEBHOOK_TOKEN=

# Comma-separated IPs of reverse proxies allowed to set X-Real-IP /
# X-Forwarded-For. Empty (default) = ignore those headers and rate-limit on
# the immediate TCP peer. Required behind a reverse proxy so login / API
# buckets key on the real client rather than the proxy. Only list IPs you
# control — a client connecting from a listed address can spoof the headers.
# Use the proxy's IP address (a hostname never matches the TCP peer); the app
# logs a warning at startup if an entry is not an IP address.
TRUSTED_PROXIES=

# Numeric uid/gid the long-running process uses after the entrypoint chowns
# ./data. The image starts as root on purpose (so it can chown a root-owned
# bind mount), then drops privileges. Leave unset to let the deploy script
# fill them in from the deploy user.
# APP_UID=
# APP_GID=

# --- First admin (one-shot bootstrap on process start) ---
# scripts/create_admin.py is interactive (getpass). For hosts where you cannot
# `compose exec`, set BOTH email and password: when the users table is empty,
# the app creates the first admin on start. Empty/unset = no-op.
#
# Set these once, deploy, log in at <BASE_URL>/auth/login, then DELETE
# BOOTSTRAP_ADMIN_PASSWORD from .env and redeploy. Deleting the line is not
# enough while the container is still running — Compose already put it in the
# process environment. Do not put a real password in this file. If users
# already exist, the env is ignored and the app logs a warning.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
