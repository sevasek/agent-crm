<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} · agent-crm manual</title>
    <link rel="stylesheet" href="/assets/pico.min.css">
    <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <nav class="topnav">
        <a class="brand" href="/">agent-crm manual</a>
        <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Manual</a>
        {%- for item in collections.manual %}
        <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a>
        {%- endfor %}
        <a class="right" href="https://github.com/sevasek/agent-crm">GitHub ↗</a>
    </nav>
    <main id="main" class="container">
        {{ content | safe }}
    </main>
</body>
</html>
